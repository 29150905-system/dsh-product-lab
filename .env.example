# 环境变量模板
# 本地开发：复制本文件为 .env.local，再填入真实 key
# Vercel：在项目 Settings -> Environment Variables 里添加同名变量
# 自托管：参考 deploy/env.production.example
DEEPSEEK_API_KEY=

# 同步码功能需要 Redis（本地没有时同步页会提示未配置）
# REDIS_URL=redis://localhost:6379
# 可选：Upstash / Vercel KV REST（优先级高于 REDIS_URL）
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
